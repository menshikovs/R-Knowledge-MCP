# Optional GitHub token for AGENTS.md lookups (higher API rate limit). Never commit it.
GITHUB_TOKEN=

# HTTP deployment settings. Defaults are safe for local development.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
HTTP_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=cran-knowledge-mcp/0.1
CACHE_TTL_SECONDS=300
CACHE_MAX_BYTES=67108864
LOG_LEVEL=INFO
# Deterministic prompt engineering features. No external enhancer is enabled.
PROMPT_INTELLIGENCE_ENABLED=true
PROMPT_MAX_INPUT_CHARS=8000
PROMPT_MAX_OUTPUT_CHARS=24000
PROMPT_MAX_GROUNDING_PACKAGES=5
PROMPT_DEFAULT_TARGET=codex
PROMPT_DEFAULT_DETAIL_LEVEL=standard
# Tool surface: consolidated (16 tools, default) or legacy (34 tools).
MCP_TOOLSET=consolidated
# Set to 0 to force pure-Python implementations even if cran-knowledge-native is installed.
R_KNOWLEDGE_NATIVE=1
