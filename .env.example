# Optional secondary documentation integration. Leave empty to disable Context7.
CONTEXT7_API_KEY=

# HTTP deployment settings. Defaults are safe for local development.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
HTTP_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=cran-knowledge-mcp/0.1
CACHE_TTL_SECONDS=300
CACHE_MAX_BYTES=67108864
LOG_LEVEL=INFO
