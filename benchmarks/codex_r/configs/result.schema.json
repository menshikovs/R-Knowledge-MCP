{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Codex R trial (not a simulated observation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id",
    "task",
    "condition",
    "model",
    "reasoning_effort",
    "image",
    "production_commit",
    "fingerprint",
    "started_at",
    "completed_at",
    "status",
    "passed",
    "total",
    "isolation_verified",
    "artifacts",
    "usage",
    "mcp_calls",
    "mcp_errors",
    "invalid_api_calls",
    "repairs"
  ],
  "properties": {
    "trial_id": {
      "type": "string",
      "pattern": "^R(0[1-9]|1[0-2])-[ABC]-[123]$"
    },
    "task": {
      "type": "string",
      "pattern": "^R(0[1-9]|1[0-2])$"
    },
    "condition": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "production_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "scored",
        "candidate_error",
        "candidate_timeout",
        "security_violation",
        "scoring_error"
      ]
    },
    "passed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4
    },
    "total": {
      "const": 4
    },
    "isolation_verified": {
      "const": true
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "usage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "mcp_calls": {
      "type": "integer",
      "minimum": 0
    },
    "mcp_errors": {
      "type": "integer",
      "minimum": 0
    },
    "invalid_api_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "repairs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
