{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/r-knowledge-mcp/knowledge-pilot-v2/E01.schema.json",
  "title": "E01 compatibility repair answer",
  "type": "object", "additionalProperties": false,
  "required": ["classification", "r_version", "bioconductor", "packages", "dependency_edges", "changed_fields", "rationale", "sources"],
  "properties": {
    "classification": {"type": "string", "enum": ["compatible", "incompatible", "partially_compatible", "unverified"]},
    "r_version": {"type": "string"},
    "bioconductor": {"type": "string"},
    "packages": {"$ref": "#/$defs/packages"},
    "dependency_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "changed_fields": {"oneOf": [
      {"type": "string", "enum": ["r_version", "bioconductor", "packages"]},
      {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["r_version", "bioconductor", "packages"]}}
    ]},
    "rationale": {"type": "string", "minLength": 30},
    "sources": {"$ref": "#/$defs/sources"}
  },
  "$defs": {
    "package": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["version", "repository"], "properties": {"version": {"type": "string"}, "repository": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["version", "source"], "properties": {"version": {"type": "string"}, "source": {"type": "string"}}}
    ]},
    "packages": {"oneOf": [
      {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/package"}},
      {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "repository"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "repository": {"type": "string"}}}}
    ]},
    "edge": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["package", "depends_on", "minimum_version"], "properties": {"package": {"type": "string"}, "depends_on": {"type": "string"}, "minimum_version": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["package", "depends_on", "constraint"], "properties": {"package": {"type": "string"}, "depends_on": {"type": "string"}, "constraint": {"type": "string", "pattern": "^>=\\s*[0-9]+(?:\\.[0-9]+)*$"}}}
    ]},
    "sources": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string", "format": "uri"}, {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}, "claim": {"type": "string"}}}]}}
  }
}
