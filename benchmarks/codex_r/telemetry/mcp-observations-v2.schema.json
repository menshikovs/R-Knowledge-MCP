{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/r-knowledge-mcp/mcp-observations-v2.schema.json",
  "title": "Safe MCP benchmark observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "source", "client_call_number", "client_item_id", "server_call_number", "tool", "correlation_quality", "request_projection", "response_projection", "duration_ms", "client_protocol_call_id", "server_protocol_call_id"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "event_type": {"const": "mcp.call.observed"},
    "source": {"enum": ["agent_stream", "mcp_server"]},
    "client_call_number": {"type": ["integer", "null"], "minimum": 1},
    "client_item_id": {"type": ["string", "null"], "maxLength": 128},
    "server_call_number": {"type": ["integer", "null"], "minimum": 1},
    "tool": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,63}$"},
    "correlation_quality": {"enum": ["confirmed", "inferred_ordinal", "unmatched_client", "unmatched_server"]},
    "request_projection": {"$ref": "#/$defs/request"},
    "response_projection": {"$ref": "#/$defs/response"},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "client_protocol_call_id": {"type": ["string", "null"], "maxLength": 128},
    "server_protocol_call_id": {"type": ["string", "null"], "maxLength": 128}
  },
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["projected", "partially_projected", "unavailable", "failed"]},
        "unknown_argument_count": {"type": ["integer", "null"], "minimum": 0},
        "query_present": {"type": "boolean"},
        "query_length_bytes": {"type": "integer", "minimum": 0},
        "query_line_count": {"type": "integer", "minimum": 1},
        "query_word_count": {"type": "integer", "minimum": 0},
        "query_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{32}$"},
        "query_projection_status": {"enum": ["projected", "redacted"]},
        "query_text": {"type": "string", "maxLength": 8192},
        "request_bytes": {"type": ["integer", "null"], "minimum": 0},
        "package": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]{0,99}$"},
        "repository": {"enum": ["cran", "bioconductor", "all", "CRAN", "Bioconductor"]},
        "r_version": {"type": "string", "maxLength": 40},
        "bioc_version": {"type": "string", "maxLength": 40},
        "package_version": {"type": "string", "maxLength": 40},
        "version": {"type": "string", "maxLength": 40},
        "function": {"type": "string", "maxLength": 64},
        "section": {"type": "string", "maxLength": 100},
        "offset": {"type": "integer", "minimum": 0, "maximum": 10000},
        "limit": {"type": "integer", "minimum": 0, "maximum": 10000},
        "snapshot_present": {"type": "boolean"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["projected", "partially_projected", "unavailable", "failed"]},
        "is_error": {"type": ["boolean", "null"]},
        "error_codes": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
        "package": {"type": "string", "maxLength": 100},
        "version": {"type": "string", "maxLength": 40},
        "requested_version": {"type": "string", "maxLength": 40},
        "r_version": {"type": "string", "maxLength": 40},
        "bioc_version": {"type": "string", "maxLength": 40},
        "repository": {"type": "string", "maxLength": 32},
        "verification_status": {"type": "string", "maxLength": 64},
        "compatibility_status": {"type": "string", "maxLength": 64},
        "partial": {"type": "boolean"},
        "checked_at": {"type": "string", "format": "date-time", "maxLength": 32},
        "available_aliases": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 64}},
        "closest_aliases": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 64}},
        "aliases": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 64}},
        "source_urls": {"type": "array", "maxItems": 16, "items": {"type": "string", "format": "uri", "maxLength": 512}},
        "truncated": {"type": "boolean"},
        "output_truncated": {"type": "boolean"},
        "page_truncated": {"type": "boolean"},
        "next_offset": {"type": ["integer", "null"], "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "alias_count": {"type": "integer", "minimum": 0},
        "source_count": {"type": "integer", "minimum": 0},
        "structured_bytes": {"type": ["integer", "null"], "minimum": 0},
        "useful_bytes": {"type": ["integer", "null"], "minimum": 0},
        "response_bytes": {"type": ["integer", "null"], "minimum": 0},
        "text_content_bytes": {"type": ["integer", "null"], "minimum": 0},
        "duration_ms": {"type": ["number", "null"], "minimum": 0},
        "secret_or_complex_payload_detected": {"type": "boolean"}
      }
    }
  }
}
